# GEMINI_API_KEY: Server-side secret required for Google Gemini AI calls.
# Locally: supply your Gemini API key here for testing.
# Production (Cloud Run): Injected securely from Google Cloud Secret Manager (valueFrom.secretKeyRef).
GEMINI_API_KEY="your-gemini-api-key"

# VITE_GOOGLE_MAPS_API_KEY: Public browser key for Google Maps Platform JavaScript API.
# Locally: provide your development key (restricted to localhost).
# Production: baked into Vite bundle during container build (restricted to your Cloud Run domain).
VITE_GOOGLE_MAPS_API_KEY="your-restricted-maps-browser-key"

# APP_URL: Optional host URL where the service is deployed.
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000)
PORT=3000
